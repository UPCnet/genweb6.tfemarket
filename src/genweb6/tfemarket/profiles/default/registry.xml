<?xml version="1.0"?>
<registry
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  i18n:domain="genweb6.tfemarket">

  <records
    interface="Products.CMFPlone.interfaces.IBundleRegistry"
    prefix="plone.bundles/tfemarket-bundle">

    <value key="enabled">True</value>
    <value key="compile">True</value>
    <value key="resources">
      <element>tfemarket-main</element>
    </value>
    <value key="jscompilation" />
    <value key="csscompilation">++theme++genweb6.tfemarket/stylesheets/theme-tfemarket.min.css</value>

  </records>

  <!-- folder_contents (pat-structure): plone.icon.contenttype mas portal type normalizado -->
  <record name="plone.icon.contenttype/genweb-tfemarket-application">
    <field type="plone.registry.field.TextLine">
      <title>TFEmarket application</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/envelope-paper.svg</value>
  </record>
  <record name="plone.icon.contenttype/genweb-tfemarket-market">
    <field type="plone.registry.field.TextLine">
      <title>TFEmarket market</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/inboxes.svg</value>
  </record>
  <record name="plone.icon.contenttype/genweb-tfemarket-offer">
    <field type="plone.registry.field.TextLine">
      <title>TFEmarket offer</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/file-earmark-text.svg</value>
  </record>

</registry>
